# ============================================================
# Agri2Value — Monorepo .gitignore
# ============================================================

# ---- Environment and secrets (NEVER commit) ----------------
.env
.env.local
.env.*.local
*.env
**/.env
**/.env.local

# ---- Python --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# Pytest
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# ---- Node / Frontend -----------------------------------------
node_modules/
frontend/node_modules/
*.tsbuildinfo
frontend/dist/
frontend/build/
frontend/.vite/
.pnp
.pnp.js

# ---- Database ------------------------------------------------
*.db
*.sqlite3
postgres_data/

# ---- ML Models -----------------------------------------------
ml/models/*.pt
ml/models/*.pth
ml/models/*.pkl
ml/models/*.h5
ml/models/*.onnx
ml/data/
*.model

# ---- IDE and OS ----------------------------------------------
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----------------------------------------------------
*.log
logs/
*.pid

# ---- Uploads (runtime) ---------------------------------------
backend/uploads/
uploads/

# ---- Alembic (keep versions, ignore cache) -------------------
backend/migrations/__pycache__/

# ---- Docker --------------------------------------------------
postgres_data/

# ---- Reference Audit Projects (External Clones) --------------
reference-projects/

.vercel
