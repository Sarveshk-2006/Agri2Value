# ============================================================
# Agri2Value — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application -------------------------------------------
APP_NAME="Agri2Value"
APP_ENV=development
# Options: development | staging | production
DEBUG=true

# ---- Backend API -------------------------------------------
# Public URL of the FastAPI backend (used by frontend builds)
API_BASE_URL=http://localhost:8000

# ---- Database (PostgreSQL) ---------------------------------
# Connection string format:
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://agri2value:agri2value_dev@localhost:5432/agri2value_db

# Synchronous URL for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://agri2value:agri2value_dev@localhost:5432/agri2value_db

# ---- Authentication (JWT) ----------------------------------
# CHANGE THESE TO RANDOM SECRETS IN PRODUCTION
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 1440 = 24 hours
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Demo Authentication -----------------------------------
# The demo OTP code accepted for any phone number in development.
# ONLY used when APP_ENV != production.
# NEVER use this in a real deployment without a real OTP provider.
DEMO_OTP_CODE=123456
DEMO_MODE=true

# ---- CORS --------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- File Storage (S3-compatible) --------------------------
# Leave blank to use local filesystem storage for development
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ---- External Intelligence APIs (Phase 2.6) ---------------
# Data.gov.in API Key for Agmarknet live daily APMC mandi prices
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# Open-Meteo Meteorological Service (Free, no key required, CC BY 4.0 attribution)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ---- Real OTP Provider (future phase) ---------------------
# Only needed when DEMO_MODE=false and a real SMS provider is configured.
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER_ID=

# ---- Frontend (Vite) ---------------------------------------
# Vite exposes only variables prefixed with VITE_
# These go into frontend/.env
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Agri2Value
VITE_DEMO_MODE=true
