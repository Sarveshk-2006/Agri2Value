# ============================================================
# Agri2Value — Production Environment Template for Railway & Neon
# ============================================================

# ---- Application Core ----
APP_NAME=Agri2Value
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# ---- Neon PostgreSQL Database ----
# Connection string from Neon Console (with sslmode=require)
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-PROJECT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_SYNC=postgresql+psycopg2://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-PROJECT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---- Cryptographic JWT Security ----
# Generate 64-byte random hex: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=GENERATE_A_LONG_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Authentication Mode ----
# Set to false in production to enforce real MSG91 SMS delivery
DEMO_MODE=false
DEMO_OTP_CODE=

# ---- MSG91 SMS Gateway (India) ----
# Active credentials from MSG91 dashboard
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=YOUR_MSG91_OTP_FLOW_TEMPLATE_ID
MSG91_SENDER_ID=AGRVAL
MSG91_BASE_URL=https://control.msg91.com/api/v5
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ---- CORS Origins ----
# Must include live Vercel frontend URL
CORS_ORIGINS=https://agri2value.vercel.app,http://localhost:5173

# ---- External Intelligence Feeds ----
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource
